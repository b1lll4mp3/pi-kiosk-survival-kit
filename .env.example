# ---- shared by kiosk.sh, dashboard_watchdog.sh, canary_baseline.sh ----
# Base URL of the server that renders the dashboard pages AND stores the heartbeats
# (the reference implementation is Node-RED endpoints, but anything HTTP works).
DASHBOARD_SERVER=http://192.0.2.10:1880

# Optional: full page URL for kiosk.sh if it is not $DASHBOARD_SERVER/endpoint/dashboard
#DASHBOARD_URL=http://192.0.2.10:1880/endpoint/dashboard-family

# dashboard_watchdog.sh second-opinion probe: any host on ANOTHER subnet that answers TCP :53
# (your DNS server is ideal). Used to catch "NetworkManager says connected but no traffic
# passes". Never use ICMP for the cross-subnet leg — it is commonly filtered.
DNS_PROBE_HOST=192.0.2.53

# ---- dashboard_extwatch.sh (layer 4, runs on a server, not the Pi) ----
# Home Assistant base URL + long-lived access token (put HA_TOKEN in the file that
# ENV_FILE points at, default ~/.config/dashboard_extwatch.env — NOT in this repo).
#HA_URL=http://192.0.2.30:8123
#HA_TOKEN=put-me-in-the-env-file-not-in-git

# ---- canary_baseline.sh ----
#BOARD_IP=192.0.2.52          # the canary board
#KEY=~/.ssh/id_ed25519        # ssh key that can reach pi@$BOARD_IP
